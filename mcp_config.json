{
  "mcpServers": {
    "ai-hacking-agent": {
      "command": "python",
      "args": ["-m", "mcp_server"],
      "env": {
        "PYTHONPATH": ".",
        "MCP_SERVER_HOST": "127.0.0.1",
        "MCP_SERVER_PORT": "8000"
      },
      "disabled": false,
      "autoApprove": [
        "port_scan",
        "service_detection",
        "directory_bruteforce",
        "sql_injection_scan",
        "xss_scan",
        "ssrf_scan",
        "vulnerability_scan",
        "generate_report"
      ]
    }
  },
  "tools": [
    {
      "name": "port_scan",
      "description": "端口扫描 - 扫描目标主机的开放端口和服务",
      "parameters": {
        "target": {"type": "string", "description": "目标IP或域名"},
        "ports": {"type": "string", "description": "端口范围，如1-1000或80,443,8080"},
        "scan_type": {"type": "string", "enum": ["syn", "connect", "udp"], "default": "syn"}
      }
    },
    {
      "name": "service_detection",
      "description": "服务识别 - 识别目标端口运行的服务和版本",
      "parameters": {
        "target": {"type": "string", "description": "目标IP或域名"},
        "port": {"type": "integer", "description": "端口号"}
      }
    },
    {
      "name": "directory_bruteforce",
      "description": "目录爆破 - 爆破Web应用的隐藏目录和文件",
      "parameters": {
        "url": {"type": "string", "description": "目标URL"},
        "wordlist": {"type": "string", "description": "字典文件路径"},
        "extensions": {"type": "string", "description": "文件扩展名，如php,asp,txt"}
      }
    },
    {
      "name": "sql_injection_scan",
      "description": "SQL注入扫描 - 检测目标URL的SQL注入漏洞",
      "parameters": {
        "url": {"type": "string", "description": "目标URL"},
        "param": {"type": "string", "description": "测试参数名"},
        "method": {"type": "string", "enum": ["GET", "POST"], "default": "GET"}
      }
    },
    {
      "name": "xss_scan",
      "description": "XSS扫描 - 检测目标URL的跨站脚本漏洞",
      "parameters": {
        "url": {"type": "string", "description": "目标URL"},
        "param": {"type": "string", "description": "测试参数名"}
      }
    },
    {
      "name": "ssrf_scan",
      "description": "SSRF扫描 - 检测目标URL的服务器端请求伪造漏洞",
      "parameters": {
        "url": {"type": "string", "description": "目标URL"},
        "param": {"type": "string", "description": "测试参数名"}
      }
    },
    {
      "name": "vulnerability_scan",
      "description": "综合漏洞扫描 - 对目标进行全面漏洞扫描",
      "parameters": {
        "target": {"type": "string", "description": "目标URL或IP"},
        "scan_level": {"type": "string", "enum": ["quick", "standard", "deep"], "default": "standard"},
        "vuln_types": {"type": "array", "items": {"type": "string"}, "description": "漏洞类型列表"}
      }
    },
    {
      "name": "jwt_analysis",
      "description": "JWT分析 - 分析JWT令牌的安全性",
      "parameters": {
        "token": {"type": "string", "description": "JWT令牌"}
      }
    },
    {
      "name": "openapi_analysis",
      "description": "OpenAPI分析 - 分析OpenAPI/Swagger规范的安全性",
      "parameters": {
        "spec_url": {"type": "string", "description": "OpenAPI规范URL"},
        "spec_content": {"type": "string", "description": "OpenAPI规范内容(JSON)"}
      }
    },
    {
      "name": "cve_lookup",
      "description": "CVE查询 - 查询CVE漏洞详情",
      "parameters": {
        "cve_id": {"type": "string", "description": "CVE编号，如CVE-2021-44228"}
      }
    },
    {
      "name": "generate_report",
      "description": "生成报告 - 生成安全测试报告",
      "parameters": {
        "task_id": {"type": "string", "description": "任务ID"},
        "format": {"type": "string", "enum": ["json", "markdown", "html"], "default": "markdown"}
      }
    },
    {
      "name": "super_agent_execute",
      "description": "超级智能体执行 - 通过自然语言驱动完整安全测试流程",
      "parameters": {
        "task": {"type": "string", "description": "自然语言任务描述，如'扫描127.0.0.1的端口和服务'"}
      }
    }
  ]
}
