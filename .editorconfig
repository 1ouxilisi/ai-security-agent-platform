# EditorConfig is awesome: https://EditorConfig.org

# 顶级配置文件
root = true

# 所有文件的默认配置
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Python文件
[*.py]
indent_size = 4
max_line_length = 120

# JavaScript文件
[*.js]
indent_size = 2

# TypeScript文件
[*.ts]
indent_size = 2

# CSS文件
[*.css]
indent_size = 2

# HTML文件
[*.html]
indent_size = 2

# JSON文件
[*.json]
indent_size = 2

# YAML文件
[*.{yml,yaml}]
indent_size = 2

# Markdown文件
[*.md]
trim_trailing_whitespace = false

# Shell脚本
[*.sh]
indent_size = 4

# Batch文件
[*.bat]
end_of_line = crlf
indent_size = 4

# PowerShell脚本
[*.ps1]
end_of_line = crlf
indent_size = 4

# Makefile
[Makefile]
indent_style = tab

# 配置文件
[*.{ini,cfg,conf}]
indent_size = 4

# 忽略文件
[.gitignore]
trim_trailing_whitespace = false
