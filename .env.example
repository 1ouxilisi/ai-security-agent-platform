# ============================================
# AI Hacking Agent - 完整配置文件示例
# ============================================
# 复制此文件为 .env，然后填入你的配置值
# 注意：.env 文件包含敏感信息，不要提交到代码仓库

# ============================================
# 1. LLM 大模型配置（必填）
# ============================================
# API密钥（必填，支持所有兼容OpenAI格式的大模型）
LLM_API_KEY=your-api-key-here

# API基础地址
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# 智谱AI: https://open.bigmodel.cn/api/paas/v4
# 硅基流动: https://api.siliconflow.cn/v1
# 月之暗面: https://api.moonshot.cn/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称
# DeepSeek: deepseek-chat / deepseek-reasoner
# OpenAI: gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 智谱AI: glm-4 / glm-3-turbo / glm-4-flash
LLM_MODEL=deepseek-chat

# 生成温度（0-1，越低越确定，越高越随机）
LLM_TEMPERATURE=0.7

# 最大生成token数
LLM_MAX_TOKENS=4096

# ============================================
# 2. MCP 服务器配置
# ============================================
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_MODE=http

# ============================================
# 3. Playwright 浏览器自动化配置
# ============================================
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SLOW_MO=0

# ============================================
# 4. 桌面自动化配置
# ============================================
DESKTOP_SCREENSHOT_DIR=./screenshots
DESKTOP_CONFIDENCE=0.8
DESKTOP_MOUSE_DURATION=0.5

# ============================================
# 5. 安全扫描配置
# ============================================
# 允许扫描的目标（逗号分隔，支持通配符）
# 生产环境建议只允许授权目标
ALLOWED_TARGETS=localhost,127.0.0.1

# 扫描速率限制（请求/秒）
SCAN_RATE_LIMIT=10

# 最大并发数
MAX_CONCURRENCY=5

# ============================================
# 6. Metasploit 配置（可选）
# ============================================
MSF_HOST=127.0.0.1
MSF_PORT=55553
MSF_USERNAME=msf
MSF_PASSWORD=msf

# ============================================
# 7. 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log
LOG_RETENTION_DAYS=30

# ============================================
# 8. 报告配置
# ============================================
REPORT_OUTPUT_DIR=./reports
REPORT_FORMAT=markdown

# ============================================
# 9. API 服务配置
# ============================================
# API认证密钥（调用API时需要在Header中传入 X-API-Key）
API_AUTH_KEY=your-api-auth-key-here

# 是否启用API认证
API_AUTH_ENABLED=true

# ============================================
# 10. 数据库配置
# ============================================
# SQLite数据库路径
DATABASE_URL=sqlite:///./data/hacking_agent.db

# ============================================
# 11. Redis 配置（可选，用于缓存和任务队列）
# ============================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=false

# ============================================
# 12. SaaS 多租户配置（可选）
# ============================================
SAAS_ENABLED=false
SAAS_DEFAULT_PLAN=free

# ============================================
# 13. 通知配置（可选）
# ============================================
# 邮件通知
NOTIFICATION_EMAIL_SMTP_HOST=smtp.example.com
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_USERNAME=your-email@example.com
NOTIFICATION_EMAIL_PASSWORD=your-email-password

# 钉钉通知
NOTIFICATION_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token

# 企业微信通知
NOTIFICATION_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# 通用Webhook通知
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com

# ============================================
# 14. JWT 认证配置
# ============================================
# JWT密钥（生产环境必须修改为随机字符串）
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 15. 默认用户配置（安全警告：生产环境必须修改！）
# ============================================
# ⚠️ 安全警告：首次启动后必须修改这些默认密码！
DEFAULT_ADMIN_PASSWORD=Admin123456
DEFAULT_TEST_PASSWORD=Test123456

# ============================================
# 16. 靶场配置（可选，用于测试）
# ============================================
DVWA_USERNAME=admin
DVWA_PASSWORD=password
MSFADMIN_USERNAME=admin
MSFADMIN_PASSWORD=admin

# ============================================
# 17. 漏洞数据库配置
# ============================================
VULN_DB_PATH=./data/vulnerabilities.json
VULN_DB_AUTO_SYNC=true
VULN_DB_SYNC_INTERVAL_HOURS=24

# NVD API配置（可选，用于同步CVE数据）
# 申请地址：https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_SYNC_DAYS=30
NVD_MAX_RESULTS=2000

# Exploit-DB配置
EXPLOIT_DB_ENABLED=true
EXPLOIT_DB_MAX_CVES=1000

# Vulners API配置（可选，用于漏洞情报）
# 申请地址：https://vulners.com/
VULNERS_API_KEY=
VULNERS_SYNC_QUERY=type:cve
VULNERS_MAX_RESULTS=1000

# ============================================
# 18. 漏洞情报监控配置
# ============================================
VULN_INTEL_ENABLED=false
VULN_INTEL_MIN_SEVERITY=high
VULN_INTEL_CHECK_INTERVAL_HOURS=6
VULN_INTEL_KEYWORDS=rce,sql-injection,xss
VULN_INTEL_VENDORS=microsoft,adobe,apache

# ============================================
# 19. 通知开关配置
# ============================================
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=https://your-webhook-url.com
NOTIFY_DINGTALK_ENABLED=false
NOTIFY_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-token
NOTIFY_DINGTALK_SECRET=your-dingtalk-secret
NOTIFY_WECOM_ENABLED=false
NOTIFY_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ============================================
# 配置完成
# ============================================
# 总配置项：74个
# 必填项：LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, API_AUTH_KEY, JWT_SECRET_KEY
# 可选项：其他所有配置项都有默认值，可根据需要修改
