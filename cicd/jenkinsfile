// =============================================================================
// AI Hacking Agent - Jenkins Pipeline 安全扫描集成模板
// =============================================================================
// 使用说明：
//   1. 确保Jenkins已安装以下插件：
//      - Pipeline: 工作流插件
//      - HTML Publisher: 发布HTML报告
//      - Timestamper: 日志时间戳
//      - Credentials Plugin: 管理密钥
//   2. 创建Pipeline任务，将本文件内容粘贴到Pipeline脚本中
//   3. 配置环境变量（在Jenkins任务配置中）：
//      - AI_HACKING_API_URL:  API服务地址
//      - AI_HACKING_TARGET:   扫描目标
//      - AI_HACKING_API_KEY:  API密钥（使用Credentials绑定）
//   4. 按需调整阈值和扫描策略
//
// 流水线阶段：
//   Build -> Security Scan -> Vulnerability Check -> Deploy
//   任一安全阶段失败将阻止后续部署
// =============================================================================

pipeline {
    // -------------------------------------------------------------------------
    // 代理配置
    // -------------------------------------------------------------------------
    agent any

    // -------------------------------------------------------------------------
    // 环境变量配置
    // -------------------------------------------------------------------------
    environment {
        // AI Hacking Agent 配置（可在Jenkins任务中覆盖）
        AI_HACKING_API_URL = 'http://ai-hacking-agent:8000'
        AI_HACKING_TARGET = 'https://your-app.example.com'
        AI_HACKING_THRESHOLD = 'high'
        SCAN_TYPE = 'comprehensive'
        SCAN_DEPTH = 'standard'

        // 工作空间路径
        SCAN_RESULT_FILE = 'scan-result.json'
        SECURITY_REPORT = 'security-report.html'
    }

    // -------------------------------------------------------------------------
    // 选项配置
    // -------------------------------------------------------------------------
    options {
        timestamps()           // 日志加时间戳
        buildDiscarder(
            logRotator(
                numToKeepStr: '30',      // 保留30次构建
                artifactNumToKeepStr: '10' // 保留10次产物
            )
        )
        timeout(time: 30, unit: 'MINUTES')  // 总超时30分钟
        disableConcurrentBuilds()  // 禁止并发构建
    }

    // -------------------------------------------------------------------------
    // 流水线阶段
    // -------------------------------------------------------------------------
    stages {

        // =====================================================================
        // 阶段1：构建
        // =====================================================================
        stage('Build') {
            steps {
                echo '============================================'
                echo ' 阶段1: 项目构建'
                echo '============================================'

                // 检出代码
                checkout scm

                // 设置Python环境
                sh '''
                    echo "Python版本:"
                    python3 --version
                    echo "安装依赖..."
                    pip3 install --quiet requests pyyaml
                '''

                echo '构建完成'
            }
        }

        // =====================================================================
        // 阶段2：安全扫描
        // =====================================================================
        stage('Security Scan') {
            steps {
                echo '============================================'
                echo ' 阶段2: 安全扫描'
                echo '============================================'

                script {
                    try {
                        // 执行主扫描
                        sh """
                            echo "目标: \$AI_HACKING_TARGET"
                            echo "类型: \$SCAN_TYPE"
                            echo "深度: \$SCAN_DEPTH"

                            python3 -m cicd.cli scan \\
                                --target "\$AI_HACKING_TARGET" \\
                                --type "\$SCAN_TYPE" \\
                                --depth "\$SCAN_DEPTH" \\
                                --api-url "\$AI_HACKING_API_URL" \\
                                --format json \\
                                --output "${SCAN_RESULT_FILE}"
                        """

                        // 专项漏洞验证（不阻断，仅作为补充）
                        echo '执行专项漏洞验证...'
                        sh """
                            # SQL注入验证
                            python3 -m cicd.cli verify \\
                                --target "\$AI_HACKING_TARGET" \\
                                --vuln-type sql_injection \\
                                --api-url "\$AI_HACKING_API_URL" \\
                                --format json || echo "SQL注入验证未完成（不阻断）"

                            # XSS验证
                            python3 -m cicd.cli verify \\
                                --target "\$AI_HACKING_TARGET" \\
                                --vuln-type xss \\
                                --api-url "\$AI_HACKING_API_URL" \\
                                --format json || echo "XSS验证未完成（不阻断）"
                        """

                        currentBuild.result = 'SUCCESS'
                    } catch (Exception e) {
                        echo "扫描过程出现警告: ${e.getMessage()}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }

            // 无论成功失败都执行
            post {
                always {
                    script {
                        // 生成安全报告
                        try {
                            sh """
                                # 提取assessment_id
                                ASSESSMENT_ID=\$(python3 -c "
import json
try:
    with open('${SCAN_RESULT_FILE}') as f:
        data = json.load(f)
    print(data.get('assessment_id', ''))
except:
    print('')
")

                                if [ -n "\$ASSESSMENT_ID" ]; then
                                    echo "生成安全报告，assessment_id: \$ASSESSMENT_ID"
                                    python3 -m cicd.cli report \\
                                        --assessment-id "\$ASSESSMENT_ID" \\
                                        --report-format html \\
                                        --output "${SECURITY_REPORT}" \\
                                        --api-url "\$AI_HACKING_API_URL" \\
                                        --format text
                                else
                                    echo "未找到assessment_id，跳过报告生成"
                                fi
                            """
                        } catch (Exception e) {
                            echo "报告生成失败: ${e.getMessage()}"
                        }

                        // 发布HTML报告到Jenkins
                        publishHTML(target: [
                            reportName: '安全扫描报告',
                            reportDir: '.',
                            reportFiles: "${SECURITY_REPORT}",
                            keepAll: true,
                            alwaysLinkToLastBuild: true,
                            allowsMissing: true
                        ])

                        // 归档构建产物
                        archiveArtifacts artifacts: "${SCAN_RESULT_FILE}, ${SECURITY_REPORT}",
                                         fingerprint: true,
                                         allowEmptyArchive: true
                    }
                }
            }
        }

        // =====================================================================
        // 阶段3：漏洞阈值检查（决定是否允许部署）
        // =====================================================================
        stage('Vulnerability Check') {
            steps {
                echo '============================================'
                echo ' 阶段3: 漏洞阈值检查'
                echo '============================================'

                script {
                    def checkExitCode = sh(
                        script: """
                            python3 -m cicd.cli check \\
                                --target "\$AI_HACKING_TARGET" \\
                                --threshold "\$AI_HACKING_THRESHOLD" \\
                                --type "\$SCAN_TYPE" \\
                                --api-url "\$AI_HACKING_API_URL" \\
                                --format json
                        """,
                        returnStatus: true
                    )

                    echo "检查退出码: ${checkExitCode}"

                    if (checkExitCode == 0) {
                        echo '✅ 安全检查通过，允许部署'
                        currentBuild.result = 'SUCCESS'
                    } else if (checkExitCode == 1) {
                        // 发现高危漏洞，阻断部署
                        echo '❌ 安全检查未通过！发现高危/严重漏洞'
                        echo '   请修复安全问题后重新触发构建'
                        currentBuild.result = 'FAILURE'
                        error "漏洞阈值检查未通过，构建被阻止。退出码: ${checkExitCode}"
                    } else if (checkExitCode == 2) {
                        // 扫描失败
                        echo '⚠️ 扫描服务异常，构建标记为不稳定'
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        // 参数错误
                        echo '❌ 配置参数错误，请检查CLI参数'
                        currentBuild.result = 'FAILURE'
                        error "CLI参数错误，退出码: ${checkExitCode}"
                    }
                }
            }
        }

        // =====================================================================
        // 阶段4：部署（仅主分支 + 安全检查通过）
        // =====================================================================
        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                echo '============================================'
                echo ' 阶段4: 部署'
                echo '============================================'

                echo '安全检查已通过，开始部署流程...'
                // 在此添加你的实际部署命令，例如：
                // sh './deploy.sh production'
                // sh 'kubectl apply -f k8s/deployment.yaml'

                echo '部署完成'
            }
        }
    }

    // -------------------------------------------------------------------------
    // 后置处理：通知和清理
    // -------------------------------------------------------------------------
    post {
        // 构建失败时
        failure {
            echo '============================================'
            echo ' 构建失败通知'
            echo '============================================'

            // 邮件通知
            emailext(
                subject: "✖️ 安全扫描失败: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                <h2>安全扫描未通过</h2>
                <p><b>任务:</b> ${env.JOB_NAME}</p>
                <p><b>构建:</b> #${env.BUILD_NUMBER}</p>
                <p><b>分支:</b> ${env.GIT_BRANCH}</p>
                <p><b>原因:</b> 安全检查未通过，发现高危漏洞</p>
                <p><b>详情:</b> <a href="${env.BUILD_URL}">查看构建日志</a></p>
                <p><b>报告:</b> 请查看安全扫描HTML报告</p>
                """,
                mimeType: 'text/html',
                recipientProviders: [
                    developers(),
                    requestor()
                ]
            )

            // 钉钉/企业微信Webhook通知（取消注释并配置）
            // sh '''
            //     curl -X POST "https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN" \
            //       -H 'Content-Type: application/json' \
            //       -d '{
            //         "msgtype": "markdown",
            //         "markdown": {
            //           "title": "安全扫描失败",
            //           "text": "## 安全扫描失败\\n\\n- 任务: '"$JOB_NAME"'\\n- 构建: #"'"$BUILD_NUMBER"'\\n- 原因: 高危漏洞\\n- [查看详情]('"$BUILD_URL"')"
            //         }
            //       }'
            // '''
        }

        // 构建成功时
        success {
            echo '============================================'
            echo ' ✅ 所有安全检查通过！'
            echo '============================================'
        }

        // 无论成功失败都执行
        always {
            echo '清理工作空间...'
            cleanWs(cleanWhenSuccess: false, cleanWhenFailure: false, deleteDirs: true)
        }
    }
}

// =============================================================================
// Jenkins 集成最佳实践：
//
// 1. 插件安装清单：
//    - Pipeline: 核心流水线支持
//    - HTML Publisher: 发布安全报告
//    - Timestamper: 日志时间戳（可选）
//    - Credentials Binding: 安全管理API密钥
//    - Email Extension: 邮件通知
//
// 2. 安全建议：
//    - API密钥使用Jenkins Credentials管理，不要明文写在脚本中
//    - 使用环境变量注入敏感信息
//    - 限制Agent权限，使用专用扫描Agent
//
// 3. 渐进式启用：
//    - 第一周：将Vulnerability Check阶段注释掉，仅收集数据
//    - 第二周：阈值设为critical，仅阻断严重漏洞
//    - 第三周：阈值设为high，阻断高危及以上
//    - 第四周：正式启用完整阻断流程
//
// 4. 误报处理：
//    - 建立误报白名单流程
//    - 对确认的误报调整check命令的fail-on参数
//    - 定期回顾和优化规则
// =============================================================================
