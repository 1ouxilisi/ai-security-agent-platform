# =============================================================================
# .dockerignore - 排除不需要进入 Docker 镜像的文件
# 目的: 减小镜像体积，加速构建，避免泄露敏感文件
# =============================================================================

# --- Python 缓存与编译文件 ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.egg-info/
**/.mypy_cache/
**/.coverage
htmlcov/

# --- Git 版本控制 ---
.git/
.gitignore
.gitattributes
.github/

# --- 测试与开发文件 (不进入生产镜像) ---
tests/
test_*.py
**/test_*.py
pytest.ini
tox.ini
.coverage
*.cover
coverage.xml

# --- 本地开发环境与 IDE ---
.venv/
venv/
env/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- 敏感配置文件 (绝不进入镜像!) ---
.env
.env.local
.env.production
*.pem
*.key
deploy/certs/

# --- 日志与临时文件 (运行时通过卷挂载) ---
logs/
*.log
temp/
tmp/
screenshots/
*.tmp

# --- 文档与非运行时文件 (减小镜像体积) ---
docs/
*.md
!README.md
# 保留必要的 README，排除其他文档
INSTALL_ENTERPRISE.md
docs/

# --- 数据与报告 (运行时通过卷挂载) ---
data/
reports/
scan_results/
validation_reports/
uploads/

# --- CI/CD 与脚本 ---
.github/
.github/workflows/
Makefile
docker-compose*.yml
Dockerfile
Dockerfile.production
.dockerignore
check_project.py
check_tools.py
fix_warnings.py
setup_wizard.py
launcher.py
install.sh
install.bat
start.sh
start.bat
push_to_github.bat
pyproject.toml
setup.py

# --- 大文件与二进制测试素材 ---
*.apk
*.ipa
*.zip
*.tar.gz
*.rar
*.7z
test_sample.apk

# --- 已构建产物 ---
build/
dist/
*.spec
